@model LocationVoitures.Web.Models.CategoryVoiture

@{
    ViewData["Title"] = "Détails de la Catégorie : " + Model.Libelle;
}

<div class="container py-4" style="max-width: 780px;">
    <div class="card shadow-sm border-0 overflow-hidden">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Libelle" class="w-100 object-fit-cover" style="max-height: 320px;" />
        }
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="card-title text-primary mb-0">@Model.Libelle</h2>
                <span class="badge bg-secondary fs-6">ID #@Model.Id</span>
            </div>

            <h6 class="text-uppercase text-muted fw-bold small mb-2">Description du segment</h6>
            <p class="lead fs-6 text-secondary mb-4">
                @(string.IsNullOrEmpty(Model.Description) ? "Aucune description renseignée pour cette catégorie." : Model.Description)
            </p>

            <div class="bg-light p-3 rounded mb-4 border">
                <div class="row g-2 small">
                    <div class="col-sm-4 text-muted">Fichier sur disque :</div>
                    <div class="col-sm-8 font-monospace">@(Model.ImageUrl ?? "Aucun fichier")</div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">← Retour à la liste</a>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">Modifier</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Supprimer</a>
                </div>
            </div>
        </div>
    </div>
</div>
